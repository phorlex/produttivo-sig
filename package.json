{
  "name": "sig-checklist-operacional",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema interno da Sig Multimarcas para checklists operacionais personalizaveis.",
  "workspaces": ["backend", "web", "mobile", "shared"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace web -- -p 3000",
    "dev:mobile": "npm run start --workspace mobile",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace web",
    "start:backend": "npm run start --workspace backend",
    "start:web": "npm run start --workspace web",
    "build:apk": "npm run build:apk --workspace mobile",
    "build:apk:local": "gerar-apk-local.bat",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend"
  }
}
